# Runtime storage. Committed knowledge base is metadata/, vector_index/, bm25_index/.
storage/sqlite/*
!storage/sqlite/.gitkeep
storage/cache/

# Generated run artifacts. Sample decks and audits stay in the repo.
outputs/presentations/*
!outputs/presentations/.gitkeep
!outputs/presentations/sample_*
outputs/audit_reports/*
!outputs/audit_reports/.gitkeep
!outputs/audit_reports/sample_*
